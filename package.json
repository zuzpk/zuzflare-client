{
  "name": "@zuzjs/flare",
  "version": "0.2.36",
  "keywords": [
    "core",
    "zuz",
    "zuz.js",
    "zuz flare",
    "zuz flare client",
    "zuzjs"
  ],
  "description": "Official JavaScript/TypeScript client for ZuzFlare Server - Self-hosted real-time database",
  "author": "Zuz.js Team <support@zuz.com.pk>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zuzjs/flare-client.git"
  },
  "bugs": {
    "url": "https://github.com/zuzjs/flare-client/issues"
  },
  "homepage": "https://flare.zuz.com.pk",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "dev:js": "tsup --watch",
    "dev": "npm-run-all -p dev:*",
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real": "RUN_REAL_FLARE_TESTS=1 vitest run src/__tests__/client-auth.test.ts",
    "publish": "npm run build && node publish-pre.js && npm publish && node publish-post.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "sideEffects": [
    "reflect-metadata"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@zuzjs/auth": "^0.1.9",
    "@zuzjs/core": "^0.3.17"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}